# Copie para .env e ajuste conforme o ambiente.
# Chave usada para assinar os tokens JWT. Gere uma aleatória em produção.
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-forte

# Banco de dados. Padrão: SQLite local. Para PostgreSQL use:
# DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/bitfiscal
DATABASE_URL=sqlite:///./bitfiscal.db

# Backups (rsync)
BACKUP_SOURCE_DIRS=/dados/clientes,/dados/sistema
BACKUP_DEST_DIR=/mnt/backup
RSYNC_OPTIONS=-avz --delete

# Monitoramento
MONITOR_HOSTS=192.168.1.1,192.168.1.2
MONITOR_SERVICES=192.168.1.1:22,192.168.1.1:443
MONITOR_INTERVAL=300

# Controle de uso (bloqueio via /etc/hosts — requer root)
USAGE_HOSTS_FILE=/etc/hosts
USAGE_BACKUP_FILE=/etc/hosts.bak

# Base de conhecimento (FAQ)
KNOWLEDGE_BASE_FILE=data/base_conhecimento.json

# Defina como True quando servir por HTTPS (cookies seguros)
COOKIE_SECURE=False
